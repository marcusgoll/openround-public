{
  "name": "openround-iphone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test:model": "node --test tests/openround-model.test.ts tests/openround-on-course-model.test.ts tests/openround-club-evidence.test.ts tests/openround-club-statistics.test.ts tests/course-library-field-log.test.mjs tests/smart-tracking.test.ts",
    "prepare:course-catalog": "node scripts/prepare-course-catalog.mjs",
    "verify:course-catalog": "node scripts/verify-course-catalog.mjs",
    "refresh:course-library": "node scripts/refresh-course-library.mjs",
    "refresh:course-library:job": "node scripts/refresh-course-library-job.mjs",
    "verify:course-geometry": "node scripts/verify-course-geometry.mjs",
    "refresh:course-geometry": "node scripts/refresh-course-geometry.mjs",
    "refresh:course-geometry:job": "node scripts/refresh-course-geometry-job.mjs",
    "verify:course-cache": "node scripts/verify-course-cache.mjs",
    "evaluate:course-field-log": "node scripts/evaluate-course-field-log.mjs",
    "test:pwa": "node --test tests/pwa-shell.test.mjs",
    "test:runtime": "playwright test",
    "dev": "vite",
    "build": "npm run licenses && npm run prepare:course-catalog && npm run verify:course-catalog && npm run verify:course-cache && tsc && vite build",
    "native:sync": "npm run build && cap sync ios",
    "native:open": "cap open ios",
    "test:smart-tracking": "node --test tests/smart-tracking.test.ts",
    "licenses": "node scripts/generate-third-party-notices.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "@fontsource/roboto": "5.2.10",
    "@fontsource/roboto-condensed": "5.3.0",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-icons": "1.3.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marcusgoll/openround-public.git",
    "directory": "prototypes/openround-iphone"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
